{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT grouped_shapley evidence payload",
  "description": "DRAFT ONLY (add-explanation-workflows EX-OQ-2 / CONTRACT GAP-E2): the agent-side expectation of this evidence kind until the finance/v1 contract minor defines it. Never published; test fixtures only.",
  "x-finplan-status": "draft-not-published",
  "type": "object",
  "properties": {
    "evidence_kind": {
      "const": "grouped_shapley"
    },
    "subject": {
      "type": "object"
    },
    "evaluator_version": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "enum": [
          "data",
          "configuration",
          "constraints",
          "model"
        ]
      },
      "minItems": 1
    },
    "k": {
      "type": "integer"
    },
    "resolves": {
      "type": "integer"
    },
    "ordering_invariant": {
      "const": true
    },
    "tolerance": {
      "type": "number"
    },
    "phi": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "number"
          },
          "expected_return": {
            "type": "number"
          },
          "risk": {
            "type": "number"
          },
          "weights": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    },
    "total": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "number"
        },
        "expected_return": {
          "type": "number"
        },
        "risk": {
          "type": "number"
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "evidence_kind",
    "groups",
    "k",
    "resolves",
    "ordering_invariant",
    "tolerance",
    "phi",
    "total"
  ]
}
