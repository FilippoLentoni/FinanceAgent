{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT controlled_resolve_set evidence payload",
  "description": "DRAFT ONLY (add-explanation-workflows EX-OQ-2 / CONTRACT GAP-E2): the agent-side expectation of this evidence kind until the finance/v1 contract minor defines it. Never published; test fixtures only.",
  "x-finplan-status": "draft-not-published",
  "type": "object",
  "properties": {
    "evidence_kind": {
      "const": "controlled_resolve_set"
    },
    "subject": {
      "type": "object"
    },
    "evaluator_version": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "enum": [
          "data",
          "configuration",
          "constraints",
          "model"
        ]
      },
      "minItems": 1
    },
    "tolerance": {
      "type": "number"
    },
    "previous": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "number"
        },
        "expected_return": {
          "type": "number"
        },
        "risk": {
          "type": "number"
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "new": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "number"
        },
        "expected_return": {
          "type": "number"
        },
        "risk": {
          "type": "number"
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "pattern": "^(base|all|switch:(data|configuration|constraints|model))$"
          },
          "switched": {
            "type": "array",
            "items": {
              "enum": [
                "data",
                "configuration",
                "constraints",
                "model"
              ]
            }
          },
          "solution_status": {
            "enum": [
              "optimal",
              "feasible",
              "infeasible",
              "unbounded",
              "no_effect",
              "not_applicable"
            ]
          },
          "allocation": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "objective": {
            "type": "number"
          },
          "expected_return": {
            "type": "number"
          },
          "risk": {
            "type": "number"
          }
        },
        "required": [
          "label",
          "switched",
          "solution_status"
        ]
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "objective": {
                "type": "number"
              },
              "expected_return": {
                "type": "number"
              },
              "risk": {
                "type": "number"
              },
              "weights": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "total": {
      "type": "object",
      "properties": {
        "objective": {
          "type": "number"
        },
        "expected_return": {
          "type": "number"
        },
        "risk": {
          "type": "number"
        },
        "weights": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "interaction_remainder": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "objective": {
              "type": "number"
            },
            "expected_return": {
              "type": "number"
            },
            "risk": {
              "type": "number"
            },
            "weights": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "lineage": {
      "type": "object",
      "properties": {
        "solver": {
          "type": "string"
        },
        "solver_version": {
          "type": "string"
        },
        "tolerance": {
          "type": "number"
        },
        "seeds": {
          "type": "array"
        },
        "code_version": {
          "type": "string"
        },
        "deterministic": {
          "type": "boolean"
        }
      }
    },
    "spread": {
      "type": "object"
    }
  },
  "required": [
    "evidence_kind",
    "groups",
    "tolerance",
    "previous",
    "new",
    "runs",
    "effects",
    "total",
    "lineage"
  ]
}
