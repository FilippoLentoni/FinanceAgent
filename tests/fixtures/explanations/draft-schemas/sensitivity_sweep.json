{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DRAFT sensitivity_sweep evidence payload",
  "description": "DRAFT ONLY (add-explanation-workflows EX-OQ-2 / CONTRACT GAP-E2): the agent-side expectation of this evidence kind until the finance/v1 contract minor defines it. Never published; test fixtures only.",
  "x-finplan-status": "draft-not-published",
  "type": "object",
  "properties": {
    "evidence_kind": {
      "const": "sensitivity_sweep"
    },
    "subject": {
      "type": "object"
    },
    "evaluator_version": {
      "type": "string"
    },
    "base_plan_version_id": {
      "type": "string",
      "pattern": "^[a-z]{2,4}_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "parameter": {
      "type": "object",
      "properties": {
        "name": {
          "enum": [
            "risk_aversion",
            "risk_target",
            "turnover_limit",
            "max_weight",
            "min_weight"
          ]
        },
        "instrument": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "name",
        "values"
      ]
    },
    "fixed_inputs": {
      "type": "object"
    },
    "tolerance": {
      "type": "number"
    },
    "base": {
      "type": "object",
      "properties": {
        "allocation": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "metrics": {
          "type": "object"
        }
      },
      "required": [
        "allocation"
      ]
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "completion_status": {
            "const": "succeeded"
          },
          "solution_status": {
            "enum": [
              "optimal",
              "feasible",
              "infeasible",
              "unbounded",
              "no_effect",
              "not_applicable"
            ]
          },
          "allocation": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "allocation_change": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "metrics": {
            "type": "object",
            "properties": {
              "expected_return": {
                "type": "number"
              },
              "risk": {
                "type": "number"
              },
              "turnover": {
                "type": "number"
              },
              "cost_estimate": {
                "type": "number"
              }
            }
          },
          "constraint_slack": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "value",
          "completion_status",
          "solution_status"
        ],
        "if": {
          "properties": {
            "solution_status": {
              "not": {
                "const": "infeasible"
              }
            }
          }
        },
        "then": {
          "required": [
            "allocation",
            "allocation_change",
            "metrics"
          ]
        }
      }
    }
  },
  "required": [
    "evidence_kind",
    "base_plan_version_id",
    "parameter",
    "tolerance",
    "base",
    "points"
  ]
}
